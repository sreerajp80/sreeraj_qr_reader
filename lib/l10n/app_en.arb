    "description": "Title of the tamper check help card"
  },
  "helpQuishingBadge": "On-Device Computer Vision",
  "@helpQuishingBadge": {
    "description": "Badge on the tamper check help card"
  },
  "helpQuishingDesc": "On-device computer vision engine that detects physical QR code sticker tampering, fake code overlays, and print alterations before processing payloads.",
  "@helpQuishingDesc": {
    "description": "Summary of the tamper check feature"
  },
  "helpQuishingPoint1": "100% Offline & Private Guarantee: Operates entirely on-device using local camera frame computer vision with zero internet connection required.",
  "@helpQuishingPoint1": {
    "description": "Tamper check capability"
  },
  "helpQuishingPoint2": "Physical Sticker & Overlay Detection: Identifies physical stickers pasted over legitimate printed QR codes.",
  "@helpQuishingPoint2": {
    "description": "Tamper check capability"
  },
  "helpQuishingPoint3": "Edge & Alignment Anomaly Analysis: Checks for suspicious boundaries, cutouts, and alignment discrepancies.",
  "@helpQuishingPoint3": {
    "description": "Tamper check capability"
  },
  "helpQuishingPoint4": "Print Texture & Contrast Verification: Analyzes visual print artifacts, reflectivity shifts, and paper texture inconsistencies.",
  "@helpQuishingPoint4": {
    "description": "Tamper check capability"
  },
  "helpUrlTitle": "URL Safety & Link Tamper Engine",
  "@helpUrlTitle": {
    "description": "Title of the link safety help card"
  },
  "helpUrlBadge": "6-Layer Digital Safety",
  "@helpUrlBadge": {
    "description": "Badge on the link safety help card"
  },
  "helpUrlDesc": "Comprehensive digital link analysis suite protecting against malicious web links, phishing (Quishing), and URL payload tampering.",
  "@helpUrlDesc": {
    "description": "Summary of the link safety feature"
  },
  "helpUrlPoint1": "Homograph & IDN Attack Detection: Identifies spoofed domain names using mixed-script Cyrillic or lookalike Unicode characters.",
  "@helpUrlPoint1": {
    "description": "Link safety capability"
  },
  "helpUrlPoint2": "Zero-Width Space & Character Tamper Detector: Detects hidden zero-width spaces, non-printable control characters, or obfuscated payloads embedded in links.",
  "@helpUrlPoint2": {
    "description": "Link safety capability"
  },
  "helpUrlPoint3": "IP Literal & Userinfo Verification: Flags suspicious IP address hostnames and dangerous embedded credentials (e.g. user:pass@host).",
  "@helpUrlPoint3": {
    "description": "Link safety capability"
  },
  "helpUrlPoint4": "Suspicious TLD & Pattern Analysis: Scans for risky top-level domains, excessive subdomains, and unencrypted HTTP connections carrying login/payment data.",
  "@helpUrlPoint4": {
    "description": "Link safety capability"
  },
  "helpUrlPoint5": "URL Shortener Unrolling & Redirect Tracing: Identifies shortened links (bit.ly, t.co) and traces redirect chains (Active Probing required for live HTTP inspection).",
  "@helpUrlPoint5": {
    "description": "Link safety capability"
  },
  "helpUrlPoint6": "Google Safe Browsing Cloud Lookup: Optional cloud check against Google threat database when configured with an API key.",
  "@helpUrlPoint6": {
    "description": "Link safety capability"
  },
  "helpUrlPoint7": "Privacy First Guarantee: Core 5 pattern checks run 100% offline on your device without sending URLs anywhere.",
  "@helpUrlPoint7": {
    "description": "Link safety capability"
  },
