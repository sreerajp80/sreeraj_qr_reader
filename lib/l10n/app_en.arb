  },
  "helpAirQrBadge": "Optical Data Protocol",
  "@helpAirQrBadge": {
    "description": "Badge on the AirQR help card"
  },
  "helpAirQrDesc": "High-speed optical data transfer receiver designed to reconstruct large multi-part payloads serialized across animated QR code loops.",
  "@helpAirQrDesc": {
    "description": "Summary of the AirQR feature"
  },
  "helpAirQrPoint1": "Sequential Frame Assembly: Scans animated QR streams (AirQR format) frame-by-frame and stitches chunks back into complete files or text.",
  "@helpAirQrPoint1": {
    "description": "AirQR capability"
  },
  "helpAirQrPoint2": "Real-Time Live Progress: Interactive progress indicator displaying completed percentage, total payload size, missing chunk count, and decoding speed.",
  "@helpAirQrPoint2": {
    "description": "AirQR capability"
  },
  "helpAirQrPoint3": "Dual Input Modes: Supports live scanning through the camera feed or offline processing by importing saved video recordings/images from gallery.",
  "@helpAirQrPoint3": {
    "description": "AirQR capability"
  },
  "helpAirQrPoint4": "AirQR Transmitter: Reverse mode allowing payload generation and animated QR stream transmission to other devices.",
  "@helpAirQrPoint4": {
    "description": "AirQR capability"
  },
  "helpQuishingTitle": "Quishing Guard (Physical QR Sticker Tamper Check)",
